<Window x:Class="WarehousePacking.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="620" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Адрес сервера (веб)" VerticalAlignment="Center" Margin="0,5,8,5"/>
                    <TextBox x:Name="ServerBox" Grid.Row="0" Grid.Column="1" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Text="Адрес API (упаковка)" VerticalAlignment="Center" Margin="0,5,8,5"/>
                    <TextBox x:Name="ApiBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Text="Принтер А4" VerticalAlignment="Center" Margin="0,5,8,5"/>
                    <ComboBox x:Name="PrinterA4Box" Grid.Row="2" Grid.Column="1" Margin="0,5" IsEditable="True"/>
                    <TextBlock Grid.Row="3" Text="Параметры А4" VerticalAlignment="Center" Margin="0,5,8,5"/>
                    <TextBox x:Name="SettingsA4Box" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
                    <TextBlock Grid.Row="4" Text="Принтер этикеток" VerticalAlignment="Center" Margin="0,5,8,5"/>
                    <ComboBox x:Name="PrinterLabelBox" Grid.Row="4" Grid.Column="1" Margin="0,5" IsEditable="True"/>
                    <TextBlock Grid.Row="5" Text="Параметры этикеток" VerticalAlignment="Center" Margin="0,5,8,5"/>
                    <TextBox x:Name="SettingsLabelBox" Grid.Row="5" Grid.Column="1" Margin="0,5"/>
                    <TextBlock Grid.Row="6" Text="Автообновление, сек" VerticalAlignment="Center" Margin="0,5,8,5"/>
                    <TextBox x:Name="RefreshBox" Grid.Row="6" Grid.Column="1" Margin="0,5"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,12,0,8"
                           Text="Настройки сохраняются в config.env рядом с приложением. Веб — run_web.py. API — run_api.py. Печать тихая через Windows GDI, SumatraPDF не нужен. Размер этикетки: paper=ШИРИНАmm x ВЫСОТАmm."/>
                <GroupBox Header="Кэш ярлыков FBS" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="CacheSummary" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                                   Text="Удаляет скачанные PDF у заданий «Готово» и «Отменено». Задания в работе не трогает."/>
                        <Button Content="Очистить кэш выполненных заданий" HorizontalAlignment="Left" Click="OnClearCache"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Click="OnCancel"/>
            <Button Content="Сохранить" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
