<Window x:Class="WarehousePacking.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warehouse Packing"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="FlatCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1B1B1B"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE5F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource FlatRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag}" Value="today">
                    <Setter Property="Background" Value="#FFE0E3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag}" Value="tomorrow">
                    <Setter Property="Background" Value="#FFF6D0"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE5F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RowHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Rows are separated by a single horizontal rule; cells have no borders. -->
        <Style x:Key="RowLinesGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E4E4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="CellStyle" Value="{StaticResource FlatCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource FlatRow}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource RowHeader}"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Готово"/>
        </StatusBar>
        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Настройки" Click="OnSettings"/>
                <Button Content="Выйти" Click="OnLogout"/>
            </StackPanel>
        </DockPanel>
        <TabControl x:Name="Tabs" Margin="10" SelectionChanged="OnTabChanged">
            <TabItem Header="Упаковка FBO">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Обновить" Click="OnReloadFbo"/>
                        <Button DockPanel.Dock="Left" Content="Скачать ярлыки" Click="OnDownloadFboLabels"/>
                        <Button DockPanel.Dock="Left" Content="Печать QR поставки" Click="OnPrintFboSupplyQr"/>
                        <Button DockPanel.Dock="Left" Content="Печать листов" Click="OnPrintFboPalletSheets"/>
                        <TextBlock x:Name="FboCacheHint" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555"/>
                        <TextBlock x:Name="FboApiHint" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" MinWidth="200"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="480"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Мои задания FBO WB" Margin="0,0,0,4"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Назад" Click="OnFboJobsPrev" x:Name="FboJobsPrev"/>
                                <TextBlock x:Name="FboJobsPageLabel" VerticalAlignment="Center" Margin="8,0"/>
                                <Button Content="Вперёд" Click="OnFboJobsNext" x:Name="FboJobsNext"/>
                            </StackPanel>
                            <DataGrid x:Name="FboJobsGrid" Style="{StaticResource RowLinesGrid}"
                                      SelectionChanged="OnFboJobSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="52" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Готово" Binding="{Binding Progress}" Width="72" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="FboJobTitle" Text="Выберите задание" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="FboJobStats" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <GroupBox Header="Активное грузоместо (наклеить этикетку)" DockPanel.Dock="Top" Margin="0,8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="110" Height="110" Background="#F3F3F3" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,10,0">
                                        <Image x:Name="FboActiveImage" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="FboActiveText" Text="Нет активной строки — пикните товар" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="FboQtyWarning" Text="" TextWrapping="Wrap"
                                                   FontSize="20" FontWeight="Bold" Foreground="#C0392B"
                                                   Margin="0,8,0,0" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Перепечатать ярлык" Click="OnFboReprint"/>
                                            <Button Content="Отменить печать" Click="OnFboCancelPrint"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </GroupBox>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Сканер" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="OK" Click="OnFboScan"/>
                                <TextBox x:Name="FboScanBox" Margin="8,0" KeyDown="OnFboScanKey"/>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="FboManualBox" Content="Ручная сборка (остаток + ШК с экрана)" Click="OnFboManualToggle"/>
                                <CheckBox x:Name="FboBatchBox" Content="Печатать все этикетки на SKU" Margin="16,0,0,0"/>
                                <CheckBox x:Name="FboSkipMpBox" Content="Без подтверждения ШК с МП" Margin="16,0,0,0"/>
                            </StackPanel>
                            <GroupBox x:Name="FboManualPanel" Header="Остаток к сборке" DockPanel.Dock="Top" Height="220" Margin="0,0,0,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <DataGrid x:Name="FboRemainingGrid" Style="{StaticResource RowLinesGrid}"
                                              MouseDoubleClick="OnFboRemainingPick">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Фото" Width="48" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding Photo}" Width="30" Height="30" Stretch="Uniform"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Ост." Binding="{Binding Qty}" Width="52" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="ШК" Binding="{Binding Barcode}" Width="120" ElementStyle="{StaticResource CellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <Button Content="Взять (тап)" Click="OnFboRemainingPick"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Строки задания" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="Назад" Click="OnFboLinesPrev" x:Name="FboLinesPrev"/>
                                        <TextBlock x:Name="FboLinesPageLabel" VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Content="Вперёд" Click="OnFboLinesNext" x:Name="FboLinesNext"/>
                                    </StackPanel>
                                    <DataGrid x:Name="FboLinesGrid" Style="{StaticResource RowLinesGrid}"
                                              PreviewMouseRightButtonDown="OnGridRightButtonDown"
                                              ContextMenuOpening="OnFboLinesContextOpening">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Статус: готово" Click="OnFboLineStatusToggle"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding Seq}" Width="44" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTemplateColumn Header="Фото" Width="48" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding Photo}" Width="30" Height="30" Stretch="Uniform"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Грузоместо" Binding="{Binding Order}" Width="130" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="FBO WB new">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Обновить" Click="OnReloadFboNew"/>
                        <TextBlock x:Name="FboNewApiHint" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" MinWidth="200"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="480"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Мои задания FBO WB new" Margin="0,0,0,4"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Назад" Click="OnFboNewJobsPrev" x:Name="FboNewJobsPrev"/>
                                <TextBlock x:Name="FboNewJobsPageLabel" VerticalAlignment="Center" Margin="8,0"/>
                                <Button Content="Вперёд" Click="OnFboNewJobsNext" x:Name="FboNewJobsNext"/>
                            </StackPanel>
                            <DataGrid x:Name="FboNewJobsGrid" Style="{StaticResource RowLinesGrid}"
                                      SelectionChanged="OnFboNewJobSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="52" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Готово" Binding="{Binding Progress}" Width="90" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="FboNewJobTitle" Text="Выберите задание" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="FboNewJobStats" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <GroupBox Header="Печать ШК грузомест WB заранее" DockPanel.Dock="Top" Margin="0,8" Padding="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Напечатать" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FboNewPrintCount" Width="56" Margin="8,0" Text="10"/>
                                    <TextBlock Text="ШК грузомест" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Печать" Click="OnFboNewPrintBoxes"/>
                                    <Button Content="Перепечатать последний" Click="OnFboNewReprintLast" Margin="8,0,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Товар и грузоместо" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8">
                                <StackPanel>
                                    <TextBlock x:Name="FboNewSelectedText" Text="Сначала пикните товар, затем грузоместо" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FboNewQtyWarning" Text="" TextWrapping="Wrap"
                                               FontSize="20" FontWeight="Bold" Foreground="#C0392B"
                                               Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Кол-во" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FboNewQtyBox" Width="72" Margin="8,0"/>
                                        <TextBlock Text="Дата производства" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        <DatePicker x:Name="FboNewProductionDate" Width="150" Margin="8,0"/>
                                        <CheckBox x:Name="FboNewRememberQty" Content="Задать количество для всех последующих грузомест с этим SKU" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Сканер" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="OK" Click="OnFboNewScan"/>
                                <TextBox x:Name="FboNewScanBox" Margin="8,0" KeyDown="OnFboNewScanKey"/>
                            </DockPanel>
                            <GroupBox Header="Остаток к раскладке" >
                                <DataGrid x:Name="FboNewRemainingGrid" Style="{StaticResource RowLinesGrid}"
                                          MouseDoubleClick="OnFboNewRemainingDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Фото" Width="48" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Photo}" Width="30" Height="30" Stretch="Uniform"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Осталось" Binding="{Binding Qty}" Width="80" ElementStyle="{StaticResource CellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Упаковка FBS">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Обновить" Click="OnReloadFbs"/>
                        <Button DockPanel.Dock="Left" Content="Скачать ярлыки" Click="OnDownloadFbsLabels"/>
                        <TextBlock x:Name="FbsCacheHint" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555"/>
                        <TextBlock x:Name="FbsApiHint" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" MinWidth="200"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="480"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Мои задания FBS" Margin="0,0,0,4"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Назад" Click="OnFbsJobsPrev" x:Name="FbsJobsPrev"/>
                                <TextBlock x:Name="FbsJobsPageLabel" VerticalAlignment="Center" Margin="8,0"/>
                                <Button Content="Вперёд" Click="OnFbsJobsNext" x:Name="FbsJobsNext"/>
                            </StackPanel>
                            <DataGrid x:Name="FbsJobsGrid" Style="{StaticResource RowLinesGrid}"
                                      SelectionChanged="OnFbsJobSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="52" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Готово" Binding="{Binding Progress}" Width="72" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="FbsJobTitle" Text="Выберите задание" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="FbsJobStats" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <GroupBox Header="Активная строка (наклеить ярлык заказа)" DockPanel.Dock="Top" Margin="0,8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="110" Height="110" Background="#F3F3F3" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,10,0">
                                        <Image x:Name="FbsActiveImage" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="FbsActiveText" Text="Нет активной строки — пикните товар" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Перепечатать ярлык" Click="OnFbsReprint"/>
                                            <Button Content="Отменить печать" Click="OnFbsCancelPrint"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </GroupBox>
                            <TextBlock x:Name="FbsCisHint" DockPanel.Dock="Top" Foreground="#A33" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Сканер" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="OK" Click="OnFbsScan"/>
                                <TextBox x:Name="FbsScanBox" Margin="8,0" KeyDown="OnFbsScanKey"/>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="FbsManualBox" Content="Ручная сборка (остаток + ШК с экрана)" Click="OnFbsManualToggle"/>
                                <CheckBox x:Name="FbsBatchBox" Content="Печатать все ярлыки SKU сразу" Margin="16,0,0,0"/>
                                <CheckBox x:Name="FbsSkipMpBox" Content="Без подтверждения ШК с МП" Margin="16,0,0,0" Click="OnFbsSkipMpToggle"/>
                            </StackPanel>
                            <GroupBox x:Name="FbsManualPanel" Header="Остаток к сборке" DockPanel.Dock="Top" Height="220" Margin="0,0,0,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <DataGrid x:Name="FbsRemainingGrid" Style="{StaticResource RowLinesGrid}"
                                              SelectionChanged="OnRemainingSelected"
                                              MouseDoubleClick="OnRemainingPick">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Фото" Width="48" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding Photo}" Width="30" Height="30" Stretch="Uniform"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Ост." Binding="{Binding Qty}" Width="52" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="ШК" Binding="{Binding Barcode}" Width="120" ElementStyle="{StaticResource CellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="ШК для сканера"/>
                                        <Border Width="180" Height="80" Background="White" BorderBrush="#CCC" BorderThickness="1" Margin="0,6">
                                            <Image x:Name="FbsBarcodeImage" Stretch="Uniform"/>
                                        </Border>
                                        <Button Content="Взять (тап)" Click="OnRemainingPick"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Строки задания" Padding="6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                        <TextBlock Text="Поиск в задании" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Content="Найти" Click="OnFbsLinesSearch"/>
                                        <TextBox x:Name="FbsLinesSearch" Margin="8,0" KeyUp="OnFbsLinesSearchKey"/>
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="Назад" Click="OnFbsLinesPrev" x:Name="FbsLinesPrev"/>
                                        <TextBlock x:Name="FbsLinesPageLabel" VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Content="Вперёд" Click="OnFbsLinesNext" x:Name="FbsLinesNext"/>
                                    </StackPanel>
                                    <DataGrid x:Name="FbsLinesGrid" Style="{StaticResource RowLinesGrid}"
                                              PreviewMouseRightButtonDown="OnGridRightButtonDown"
                                              ContextMenuOpening="OnFbsLinesContextOpening">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Статус: готово" Click="OnFbsLineStatusToggle"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding Seq}" Width="44" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTemplateColumn Header="Фото" Width="48" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding Photo}" Width="30" Height="30" Stretch="Uniform"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" Width="130" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource CellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Номенклатура">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Кол-во этикеток" VerticalAlignment="Center"/>
                        <TextBox x:Name="CatalogQtyBox" Width="60" Text="1" Margin="8,0"/>
                        <TextBlock Text="для кнопки «Печать ШК»" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Поиск" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Обновить" Click="OnCatalogReload"/>
                        <Button DockPanel.Dock="Right" Content="Найти" Click="OnCatalogSearch"/>
                        <TextBox x:Name="CatalogSearchBox" Margin="8,0" KeyUp="OnCatalogSearchKey"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Назад" Click="OnCatalogPrev" x:Name="CatalogPrev"/>
                        <TextBlock x:Name="CatalogPageLabel" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Content="Вперёд" Click="OnCatalogNext" x:Name="CatalogNext"/>
                    </StackPanel>
                    <DataGrid x:Name="CatalogGrid" Style="{StaticResource RowLinesGrid}" RowHeight="44"
                              PreviewMouseRightButtonDown="OnGridRightButtonDown"
                              ContextMenuOpening="OnCatalogContextOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Печать ШК" Click="OnCatalogPrintMenu"/>
                                <MenuItem Header="Добавить ШК" Click="OnCatalogAddBarcodeMenu"/>
                                <MenuItem Header="Добавить ШК короба" Click="OnCatalogAddBoxMenu"/>
                                <MenuItem Header="Добавить GTIN" Click="OnCatalogAddGtinMenu"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Фото" Width="56" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Photo}" Width="36" Height="36" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="140" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="" Width="130" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Печать ШК" Style="{StaticResource CellButton}"
                                                Click="OnCatalogPrintButton"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Задания" Visibility="Collapsed">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить" Click="OnReloadTasks"/>
                        <Button Content="Печать все А4" Click="OnPrintAllA4"/>
                        <Button Content="Печать все этикетки" Click="OnPrintAllLabels"/>
                        <Button Content="Печать всё" Click="OnPrintAllFiles"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Мои задания" Margin="0,0,0,4"/>
                            <DataGrid x:Name="TasksGrid" Style="{StaticResource RowLinesGrid}"
                                      RowStyle="{StaticResource TaskRowStyle}"
                                      SelectionChanged="OnTaskSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата сборки" Binding="{Binding Assembly}" Width="110" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Маркетплейс" Binding="{Binding Marketplace}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Дата отгрузки" Binding="{Binding Ship}" Width="110" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Детали задания"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,8">
                                <TextBlock Text="Статус" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TaskStatusBox" Width="220" Margin="8,0,0,0" SelectionChanged="OnTaskStatusChanged"/>
                            </StackPanel>
                            <GroupBox Header="Файлы для печати" DockPanel.Dock="Bottom" Height="200" Padding="6">
                                <DataGrid x:Name="FilesGrid" Style="{StaticResource RowLinesGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="90" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Файл" Binding="{Binding Filename}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTemplateColumn Header="" Width="100" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Печать" Style="{StaticResource CellButton}"
                                                            Click="OnPrintAttachmentButton"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <TextBox x:Name="TaskDescription" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
