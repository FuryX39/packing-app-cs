<Window x:Class="WarehousePacking.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warehouse Packing — вход"
        Height="360" Width="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Вход в панель склада" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="Адрес сервера" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
        <TextBlock Grid.Row="2" Text="Адрес API" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="ApiBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="пусто = тот же хост :8766 (run_api.py)" Foreground="#666" FontSize="11"/>
        <TextBlock Grid.Row="4" Text="Логин" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="LoginBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
        <TextBlock Grid.Row="5" Text="Пароль" VerticalAlignment="Center" Margin="0,4"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
        <TextBlock x:Name="StatusText" Grid.Row="6" Grid.ColumnSpan="2" Foreground="#555" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Настройки" Click="OnSettings"/>
            <Button Content="Выход" Click="OnCancel"/>
            <Button Content="Войти" IsDefault="True" Click="OnLogin"/>
        </StackPanel>
    </Grid>
</Window>
