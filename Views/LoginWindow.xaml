<Window x:Class="WarehousePacking.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warehouse Packing — вход"
        Height="440" Width="500" ResizeMode="NoResize" SizeToContent="Height" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Margin="22" Background="White" CornerRadius="12" Padding="20,16"
                BorderBrush="#E4E8EE" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.12" Color="#1A1D21"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Упаковка" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Вход в панель склада" Foreground="#667085" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Адрес сервера" Foreground="#667085" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="ServerBox" Grid.Row="2" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="3" Text="Адрес API" Foreground="#667085" FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <TextBox x:Name="ApiBox"/>
                    <TextBlock Text="пусто = тот же хост :8766" Foreground="#98A2B3" FontSize="11" Margin="2,4,0,0"/>
                </StackPanel>
                <Grid Grid.Row="5" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Сотрудник" Foreground="#667085" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LoginBox"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Login"
                                  SelectionChanged="OnLoginSelected">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                        <TextBlock Text="{Binding Login, StringFormat={}  ({0})}"
                                                   Foreground="#667085"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Пароль" Foreground="#667085" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="#667085" Margin="0,4,0,0"/>
                <DockPanel Grid.Row="8" LastChildFill="False" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Content="Настройки" Click="OnSettings" Margin="0"/>
                    <Button DockPanel.Dock="Right" Content="Войти" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="OnLogin" Margin="0" MinWidth="88" Padding="16,6"/>
                    <Button DockPanel.Dock="Right" Content="Выход" Click="OnCancel" Margin="0,0,8,0"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
