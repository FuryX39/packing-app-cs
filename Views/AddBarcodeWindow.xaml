<Window x:Class="WarehousePacking.Views.AddBarcodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить ШК" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ProductText" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Название" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="LabelBox" Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"/>
        <TextBlock Grid.Row="2" Text="Группа" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="GroupBox" Grid.Row="2" Grid.Column="1" Margin="8,4,0,4"/>
        <TextBlock Grid.Row="3" Text="ШК" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="BarcodeBox" Grid.Row="3" Grid.Column="1" Margin="8,4,0,4"/>
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#555" Margin="0,6,0,10"
                   Text="Название — как «ШК ВБ», группа — как «Озон». ШК можно пропикать."/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True"/>
            <Button Content="Сохранить" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
